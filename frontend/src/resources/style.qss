/* ============================================
   MODERN DARK THEME v2 — Glassmorphism + Gradients
   ============================================ */

/* === MAIN WINDOW === */
QMainWindow {
    background: #0f0f1a;
}

#centralWidget {
    background: #0f0f1a;
}

/* === SIDEBAR === */
#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #14142a,
        stop:1 #0d0d1f);
    border-right: 1px solid rgba(100, 255, 218, 0.06);
}

#sidebar::separator {
    background: rgba(100, 255, 218, 0.08);
    width: 1px;
}

#sidebarHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(100, 255, 218, 0.08),
        stop:1 rgba(99, 102, 241, 0.05));
    border-bottom: 1px solid rgba(100, 255, 218, 0.08);
}

#appTitle {
    color: #e8eaf0;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

#appSubtitle {
    color: #64748b;
    font-size: 11px;
    letter-spacing: 0.3px;
}

#sectionHeader {
    border-bottom: 1px solid rgba(100, 255, 218, 0.04);
}

#sectionLabel {
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

#badge {
    background: rgba(100, 255, 218, 0.1);
    color: #64ffda;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    min-width: 20px;
}

/* === BOT LIST === */
#botList {
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 10px;
    margin: 0;
    font-size: 13px;
}

#botList::item {
    padding: 10px 14px;
    border-radius: 10px;
    margin: 3px 0;
    color: #c8cdd8;
    font-weight: 500;
    border: 1px solid transparent;
}

#botList::item:hover {
    background: rgba(100, 255, 218, 0.04);
    border: 1px solid rgba(100, 255, 218, 0.08);
}

#botList::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(100, 255, 218, 0.1),
        stop:1 rgba(99, 102, 241, 0.05));
    border: 1px solid rgba(100, 255, 218, 0.15);
    color: #e8eaf0;
}

#botList::item:selected:hover {
    background: rgba(100, 255, 218, 0.14);
}

/* === ACTIONS PANEL (sidebar bottom) === */
#actionsPanel {
    background: rgba(255, 255, 255, 0.02);
    border-top: 1px solid rgba(100, 255, 218, 0.05);
}

/* === BUTTONS === */
QPushButton {
    background: rgba(255, 255, 255, 0.04);
    color: #c8cdd8;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.2px;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(100, 255, 218, 0.15);
    color: #e8eaf0;
}

QPushButton:pressed {
    background: rgba(255, 255, 255, 0.03);
}

QPushButton:disabled {
    color: #3a3f50;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.03);
}

/* Add button - primary blue */
#addButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1,
        stop:1 #4f46e5);
    color: white;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 10px;
    padding: 9px 16px;
}

#addButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #818cf8,
        stop:1 #6366f1);
    border: 1px solid rgba(129, 140, 248, 0.4);
}

#addButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4f46e5,
        stop:1 #4338ca);
}

/* Edit button - subtle */
#editButton {
    background: rgba(250, 204, 21, 0.08);
    color: #facc15;
    border: 1px solid rgba(250, 204, 21, 0.15);
}

#editButton:hover {
    background: rgba(250, 204, 21, 0.14);
    border: 1px solid rgba(250, 204, 21, 0.25);
}

/* Delete button - danger subtle */
#deleteButton {
    background: rgba(248, 113, 113, 0.08);
    color: #f87171;
    border: 1px solid rgba(248, 113, 113, 0.15);
}

#deleteButton:hover {
    background: rgba(248, 113, 113, 0.14);
    border: 1px solid rgba(248, 113, 113, 0.25);
}

/* Start button - green */
#startButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #22c55e,
        stop:1 #16a34a);
    color: white;
    border: 1px solid rgba(34, 197, 94, 0.3);
}

#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4ade80,
        stop:1 #22c55e);
    border: 1px solid rgba(74, 222, 128, 0.4);
}

/* Stop button - red */
#stopButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ef4444,
        stop:1 #dc2626);
    color: white;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

#stopButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f87171,
        stop:1 #ef4444);
    border: 1px solid rgba(248, 113, 113, 0.4);
}

/* Stop All Action button */
#stopActionButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ef4444,
        stop:1 #b91c1c);
    color: white;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.5px;
}

#stopActionButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f87171,
        stop:1 #ef4444);
    border: 1px solid rgba(248, 113, 113, 0.5);
}

/* Refresh button */
#refreshButton {
    background: rgba(99, 102, 241, 0.1);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.2);
}

#refreshButton:hover {
    background: rgba(99, 102, 241, 0.18);
    border: 1px solid rgba(99, 102, 241, 0.3);
}

/* Send button */
#sendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1,
        stop:1 #4f46e5);
    color: white;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    font-weight: 700;
}

#sendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #818cf8,
        stop:1 #6366f1);
}

/* Command action buttons */
#cmdMoveButton, #cmdFollowButton, #cmdGuardButton,
#cmdCollectButton, #cmdDropButton, #cmdHuntButton, #cmdHuntPlayerButton {
    background: rgba(100, 255, 218, 0.06);
    color: #64ffda;
    border: 1px solid rgba(100, 255, 218, 0.15);
    border-radius: 8px;
    font-weight: 600;
    min-width: 70px;
}

#cmdMoveButton:hover, #cmdFollowButton:hover, #cmdGuardButton:hover,
#cmdCollectButton:hover, #cmdDropButton:hover, #cmdHuntButton:hover, #cmdHuntPlayerButton:hover {
    background: rgba(100, 255, 218, 0.12);
    border: 1px solid rgba(100, 255, 218, 0.25);
}

/* === CENTER PANEL === */
#centerPanel {
    background: #0f0f1a;
}

/* === HEADER FRAME === */
#headerFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(20, 20, 42, 0.95),
        stop:1 rgba(15, 15, 26, 0.98));
    border-bottom: 1px solid rgba(100, 255, 218, 0.06);
}

#botNameLabel {
    color: #e8eaf0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.3px;
}

#botStatusLabel {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 8px;
    background: rgba(100, 116, 139, 0.1);
}

#botStatusLabel[status="online"] {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
}

#botStatusLabel[status="connecting"] {
    color: #facc15;
    background: rgba(250, 204, 21, 0.1);
}

#botStatusLabel[status="error"] {
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
}

#statusGlow {
    border-radius: 6px;
    background: #64748b;
}

#infoTag {
    color: #64748b;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

#taskInfoWidget {
    padding: 0;
}

#taskStatusLabel {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
}

/* === TABS === */
#tabsContainer {
    background: transparent;
}

#centralTabs::pane {
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(100, 255, 218, 0.04);
    border-radius: 12px;
    padding: 4px;
}

#centralTabs::tab-bar {
    alignment: left;
    left: 4px;
}

QTabBar::tab {
    background: transparent;
    color: #64748b;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 20px;
    margin: 0 4px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTabBar::tab:hover {
    color: #a5b4fc;
    background: rgba(99, 102, 241, 0.04);
    border-bottom: 2px solid rgba(99, 102, 241, 0.2);
    border-radius: 0;
}

QTabBar::tab:selected {
    color: #e8eaf0;
    border-bottom: 2px solid #6366f1;
    background: rgba(99, 102, 241, 0.06);
}

/* === CARDS (generic) === */
#card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.035),
        stop:1 rgba(255, 255, 255, 0.015));
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
}

#card:hover {
    border: 1px solid rgba(100, 255, 218, 0.1);
}

/* Stat cards */
#healthCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(248, 113, 113, 0.06),
        stop:1 rgba(248, 113, 113, 0.02));
    border: 1px solid rgba(248, 113, 113, 0.12);
}

#foodCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(250, 204, 21, 0.06),
        stop:1 rgba(250, 204, 21, 0.02));
    border: 1px solid rgba(250, 204, 21, 0.12);
}

#xpCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(74, 222, 128, 0.06),
        stop:1 rgba(74, 222, 128, 0.02));
    border: 1px solid rgba(74, 222, 128, 0.12);
}

#levelCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(99, 102, 241, 0.06),
        stop:1 rgba(99, 102, 241, 0.02));
    border: 1px solid rgba(99, 102, 241, 0.12);
}

#statIcon {
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

#statValue {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
}

#statBigValue {
    color: #e8eaf0;
    font-size: 24px;
    font-weight: 800;
}

#statSubtext {
    color: #4a5568;
    font-size: 10px;
    font-weight: 500;
}

/* Details card */
#detailsCard {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

#detailIcon {
    color: #6366f1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(99, 102, 241, 0.08);
}

#detailLabel {
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}

#detailValue {
    color: #e8eaf0;
    font-size: 13px;
    font-weight: 600;
}

/* Command card */
#commandCard {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

#cmdLabel {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
}

/* === LINE EDIT === */
QLineEdit {
    background: rgba(255, 255, 255, 0.04);
    color: #e8eaf0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 12px;
    selection-background-color: rgba(99, 102, 241, 0.3);
}

QLineEdit:focus {
    border: 1px solid rgba(99, 102, 241, 0.4);
    background: rgba(99, 102, 241, 0.04);
}

QLineEdit:hover {
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QLineEdit::placeholder {
    color: rgba(100, 116, 139, 0.5);
    font-style: italic;
}

#cmdInput {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(100, 255, 218, 0.1);
    border-radius: 8px;
}

#cmdInput:focus {
    border: 1px solid rgba(100, 255, 218, 0.25);
}

#commandInput {
    background: transparent;
    border: none;
    color: #64ffda;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 13px;
    padding: 0;
}

#commandInput::placeholder {
    color: rgba(100, 255, 218, 0.25);
}

#cmdPrefix {
    color: #64ffda;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 14px;
    font-weight: 700;
}

#customCmdFrame {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(100, 255, 218, 0.08);
    border-radius: 12px;
}

/* Form inputs in dialog */
#formInput {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px 12px;
}

#formInput:focus {
    border: 1px solid rgba(99, 102, 241, 0.5);
    background: rgba(99, 102, 241, 0.05);
}

/* === TEXT EDIT (command output) === */
#commandOutput {
    background: rgba(0, 0, 0, 0.3);
    color: #a8b2d1;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 14px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Courier New', monospace;
    font-size: 12px;
    selection-background-color: rgba(99, 102, 241, 0.3);
}

#commandOutput:focus {
    border: 1px solid rgba(100, 255, 218, 0.1);
}

/* === TABLE WIDGET === */
QTableWidget {
    background: rgba(255, 255, 255, 0.02);
    color: #c8cdd8;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    gridline-color: rgba(255, 255, 255, 0.03);
    padding: 4px;
    font-size: 12px;
}

QTableWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
}

QTableWidget::item:selected {
    background: rgba(99, 102, 241, 0.12);
    color: #e8eaf0;
}

QTableWidget::item:hover {
    background: rgba(100, 255, 218, 0.04);
}

QTableWidget::item:alternate {
    background: rgba(255, 255, 255, 0.01);
}

#tableHeader {
    background: transparent;
}

QHeaderView::section {
    background: rgba(255, 255, 255, 0.03);
    color: #64748b;
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* === PROGRESS BARS === */
QProgressBar {
    background: rgba(255, 255, 255, 0.04);
    border: none;
    border-radius: 4px;
    text-align: center;
    color: transparent;
    font-size: 0px;
}

QProgressBar::chunk {
    border-radius: 4px;
}

#healthBar {
    background: rgba(248, 113, 113, 0.1);
    height: 6px;
}

#healthBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f87171,
        stop:1 #ef4444);
    border-radius: 4px;
}

#foodBar {
    background: rgba(250, 204, 21, 0.1);
    height: 6px;
}

#foodBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #facc15,
        stop:1 #eab308);
    border-radius: 4px;
}

#taskProgressBar {
    background: rgba(99, 102, 241, 0.1);
    height: 8px;
    border-radius: 4px;
}

#taskProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1,
        stop:1 #a78bfa);
    border-radius: 4px;
}

/* === SCROLL BARS === */
QScrollBar:vertical {
    background: transparent;
    border-radius: 6px;
    width: 6px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.14);
}

QScrollBar:horizontal {
    background: transparent;
    border-radius: 6px;
    height: 6px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.14);
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
    height: 0px;
    width: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* === LABEL === */
QLabel {
    color: #c8cdd8;
    font-size: 12px;
}

/* === STATUS BAR === */
#mainStatusBar {
    background: rgba(0, 0, 0, 0.4);
    color: #64748b;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding: 4px 16px;
    font-size: 11px;
}

#mainStatusBar::item {
    border: none;
}

/* === FRAME === */
QFrame[frameShape="1"] {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 12px;
}

/* === TOOLTIP === */
QToolTip {
    background: rgba(15, 15, 26, 0.95);
    color: #c8cdd8;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 11px;
}

/* === DIALOG === */
#botDialog {
    background: #14142a;
}

#dialogTitle {
    color: #e8eaf0;
    font-size: 16px;
    font-weight: 700;
    padding-bottom: 4px;
}

#infoLabelSmall {
    color: #4a5568;
    font-size: 10px;
}

#dialogButtons::ok-button {
    background: #6366f1;
    color: white;
    border-radius: 8px;
    padding: 8px 24px;
}

#dialogButtons::cancel-button {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 8px 24px;
}

/* === MESSAGE BOX === */
#notificationBox {
    background: #14142a;
}

QMessageBox QLabel {
    color: #c8cdd8;
}

QMessageBox QPushButton {
    min-width: 80px;
    border-radius: 8px;
}

/* === COMBO BOX === */
QComboBox {
    background: rgba(255, 255, 255, 0.04);
    color: #e8eaf0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 12px;
}

QComboBox:hover {
    border: 1px solid rgba(255, 255, 255, 0.14);
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #6366f1;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background: rgba(20, 20, 42, 0.97);
    color: #c8cdd8;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(99, 102, 241, 0.15);
}

/* === SPIN BOX === */
QSpinBox {
    background: rgba(255, 255, 255, 0.04);
    color: #e8eaf0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 12px;
}

QSpinBox:focus {
    border: 1px solid rgba(99, 102, 241, 0.4);
}

QSpinBox::up-button, QSpinBox::down-button {
    background: rgba(255, 255, 255, 0.03);
    border: none;
    border-radius: 4px;
    width: 18px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.08);
}

/* === CHECKBOX === */
QCheckBox {
    color: #c8cdd8;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
}

QCheckBox::indicator:hover {
    border-color: rgba(99, 102, 241, 0.4);
}

QCheckBox::indicator:checked {
    background: #6366f1;
    border-color: #6366f1;
}

/* === MENU BAR === */
QMenuBar {
    background: rgba(0, 0, 0, 0.3);
    color: #94a3b8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 14px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background: rgba(99, 102, 241, 0.1);
    color: #e8eaf0;
}

QMenu {
    background: rgba(20, 20, 42, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 18px;
    border-radius: 6px;
    color: #c8cdd8;
}

QMenu::item:selected {
    background: rgba(99, 102, 241, 0.1);
    color: #e8eaf0;
}

/* === SPLITTER === */
QSplitter::handle {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 2px;
}

QSplitter::handle:hover {
    background: rgba(99, 102, 241, 0.1);
}

/* === SCROLL AREA === */
QScrollArea {
    border: none;
    background: transparent;
}

/* === MINIMAP === */
#mapSection {
    background: transparent;
}

#mapCard {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
}

#mapTitle {
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

#mapContainer {
    background: rgba(12, 12, 22, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
}

#minimap {
    background: transparent;
}

#noDataOverlay {
    background: rgba(12, 12, 22, 0.85);
    border-radius: 10px;
}

#noDataLabel {
    color: #64748b;
    font-size: 14px;
    font-weight: 700;
}

#noDataSubLabel {
    color: #4a5568;
    font-size: 11px;
}

#legendLabel {
    color: #64748b;
    font-size: 10px;
    font-weight: 500;
}
