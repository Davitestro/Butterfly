QMainWindow {
    background-color: #2b2b2b;
}

QGroupBox {
    color: #ffffff;
    border: 1px solid #555;
    border-radius: 5px;
    margin-top: 1ex;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

QLineEdit {
    background-color: #3c3c3c;
    color: #ffffff;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 5px;
}

QPushButton {
    background-color: #505050;
    color: #ffffff;
    border: none;
    border-radius: 3px;
    padding: 8px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #606060;
}

QPushButton:pressed {
    background-color: #404040;
}

QListWidget {
    background-color: #3c3c3c;
    color: #ffffff;
    border: 1px solid #555;
    border-radius: 3px;
}

QListWidget::item:selected {
    background-color: #505050;
}

QTextEdit {
    background-color: #1e1e1e;
    color: #00ff00;
    border: 1px solid #555;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
}

QComboBox {
    background-color: #3c3c3c;
    color: #ffffff;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 5px;
}

QLabel {
    color: #ffffff;
}
